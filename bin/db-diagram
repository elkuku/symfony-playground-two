#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Renders the PlantUML class diagram written by `doctrine:diagram:class --format=puml` to SVG.
 *
 * Usage: bin/db-diagram <source.puml> <target.svg>
 *
 * Workaround: jawira/entity-draw writes "set separator \ ", and current PlantUML treats the
 * trailing backslash as a line continuation, so the server rejects the whole diagram.
 * "set separator none" has the same effect (no package boxes) and renders fine.
 */

use Jawira\PlantUmlClient\Client;
use Jawira\PlantUmlClient\Format;

require \dirname(__DIR__).'/vendor/autoload.php';

[, $source, $target] = $argv + [null, null, null];

if (!\is_string($source) || !\is_string($target)) {
    \fwrite(\STDERR, "Usage: bin/db-diagram <source.puml> <target.svg>\n");
    exit(1);
}

$diagram = \file_get_contents($source);

if (false === $diagram) {
    \fwrite(\STDERR, "Cannot read {$source}\n");
    exit(1);
}

$diagram = (string) \preg_replace('/^set separator .*$/m', 'set separator none', $diagram);

\file_put_contents($target, new Client()->generateImage($diagram, Format::SVG));

echo "Diagram written to {$target}\n";
