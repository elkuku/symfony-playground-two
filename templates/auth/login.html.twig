{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Sign in{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Only needed for "Sign in with Google" (Google Identity Services). #}
    <script src="https://accounts.google.com/gsi/client" async defer></script>
{% endblock %}

{% block body %}
    <div class="login-page mx-auto">
        <div class="card shadow-sm">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <span class="bg-logo login-logo"></span>
                    <h1 class="h3 mt-3 mb-1">Sign in</h1>
                    <p class="text-body-secondary mb-0">Use one of your existing accounts.</p>
                </div>

                {#
                    The template ships two Google logins; remove the one you don't need.
                    See doc/google-login.md.
                #}
                <div class="d-grid gap-2">
                    {# Sign in with Google (Google Identity Services), rendered by Google. #}
                    <div id="g_id_onload"
                         data-client_id="{{ oauthGoogleId }}"
                         data-login_uri="{{ url('connect_google_verify') }}"
                         data-auto_prompt="false">
                    </div>
                    <div class="g_id_signin d-flex justify-content-center"
                         data-type="standard"
                         data-size="large"
                         data-theme="outline"
                         data-text="signin_with"
                         data-shape="rectangular"
                         data-logo_alignment="left"
                         data-width="320"
                         data-locale="{{ app.request.locale }}">
                    </div>
                    <script>
                        // Google renders its button once, so pick its dark variant up front.
                        if ('dark' === document.documentElement.getAttribute('data-bs-theme')) {
                            document.querySelector('.g_id_signin').dataset.theme = 'filled_black';
                        }
                    </script>

                    {# Google, GitHub and GitLab via the OAuth redirect flow. #}
                    <a href="{{ path('connect_google_start') }}" class="btn btn-login">
                        <svg class="login-icon" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </a>
                    <a href="{{ path('connect_github_start') }}" class="btn btn-login">
                        <i class="bi-github login-icon" aria-hidden="true"></i>
                        <span>Continue with GitHub</span>
                    </a>
                    <a href="{{ path('connect_gitlab_start') }}" class="btn btn-login">
                        <i class="bi-gitlab login-icon login-icon-gitlab" aria-hidden="true"></i>
                        <span>Continue with GitLab</span>
                    </a>
                </div>

                {% if 'dev' == app.environment %}
                    <div class="login-divider my-4"><span>Development only</span></div>

                    <form method="post" action="{{ path('app_login') }}">
                        {% if error %}
                            <div class="alert alert-danger" role="alert">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}
                        <div class="input-group">
                            <div class="form-floating">
                                <input class="form-control" id="identifier" name="identifier" placeholder="Identifier"
                                       value="{{ last_username }}" autocomplete="username" required>
                                <label for="identifier">Identifier</label>
                            </div>
                            <button type="submit" class="btn btn-primary px-4">Sign in</button>
                        </div>
                        <div class="form-text">Signs in as any existing user, without a password.</div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
