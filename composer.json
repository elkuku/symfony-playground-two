{
    "name": "elkuku/symfony-playground-two",
    "description": "A Symfony project template",
    "type": "project",
    "license": "wtfpl",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3",
        "elkuku/kuku-sf-system-tools-bundle": "^1.3",
        "elkuku/symfony-utils": "^0.4",
        "google/apiclient": "^2.15",
        "knpuniversity/oauth2-client-bundle": "^v2.17.0",
        "league/oauth2-github": "^3.1",
        "league/oauth2-google": "^5.0",
        "php-cs-fixer/shim": "^3.88",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.*",
        "symfony/asset-mapper": "8.*",
        "symfony/console": "8.*",
        "symfony/doctrine-messenger": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2",
        "symfony/form": "8.*",
        "symfony/framework-bundle": "8.*",
        "symfony/http-client": "8.*",
        "symfony/intl": "8.*",
        "symfony/mailer": "8.*",
        "symfony/mime": "8.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.*",
        "symfony/process": "8.*",
        "symfony/property-access": "8.*",
        "symfony/property-info": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/serializer": "8.*",
        "symfony/stimulus-bundle": "^v3.2.0",
        "symfony/string": "8.*",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/ux-icons": "^v3.2.0",
        "symfony/ux-twig-component": "^v3.2.0",
        "symfony/validator": "8.*",
        "symfony/web-link": "8.*",
        "symfony/yaml": "8.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.86",
        "jawira/doctrine-diagram-bundle": "dev-main",
        "phpstan/phpdoc-parser": "^2",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "8.*",
        "symfony/web-profiler-bundle": "8.*",
        "tomasvotruba/cognitive-complexity": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check" : [
            "echo 'Check for outdated assets:'",
            "bin/console importmap:outdated",
            "echo 'Check for outdated PHP deps:'",
            "composer outdated",
            "echo 'Check for outdated Recipes:'",
            "composer recipes:update"
            ],
        "db-diagram": [
            "bin/console doctrine:diagram:class --filename=assets/docs/database.svg"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*"
        }
    }
}
